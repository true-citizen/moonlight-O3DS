diff --git a/src/Limelight.h b/src/Limelight.h
index ac87a4b..596d8d2 100644
--- a/src/Limelight.h
+++ b/src/Limelight.h
@@ -224,6 +224,7 @@ typedef struct _DECODE_UNIT {
 // and to DecoderRendererSetup() to specify selected codec.
 #define VIDEO_FORMAT_H264            0x0001 // H.264 High Profile
 #define VIDEO_FORMAT_H264_HIGH8_444  0x0004 // H.264 High 4:4:4 8-bit Profile
+#define VIDEO_FORMAT_H263            0x0010 // H.263+ (H.263 version 2), moonlight-N3DS extension
 #define VIDEO_FORMAT_H265            0x0100 // HEVC Main Profile
 #define VIDEO_FORMAT_H265_MAIN10     0x0200 // HEVC Main10 Profile
 #define VIDEO_FORMAT_H265_REXT8_444  0x0400 // HEVC RExt 4:4:4 8-bit Profile
@@ -235,6 +236,7 @@ typedef struct _DECODE_UNIT {
 
 // Masks for clients to use to match video codecs without profile-specific details.
 #define VIDEO_FORMAT_MASK_H264   0x000F
+#define VIDEO_FORMAT_MASK_H263   0x00F0
 #define VIDEO_FORMAT_MASK_H265   0x0F00
 #define VIDEO_FORMAT_MASK_AV1    0xF000
 #define VIDEO_FORMAT_MASK_10BIT  0xAA00
@@ -513,6 +515,7 @@ void LiInitializeConnectionCallbacks(PCONNECTION_LISTENER_CALLBACKS clCallbacks)
 #define SCM_HEVC_REXT10_444 0x00100000 // Sunshine extension
 #define SCM_AV1_HIGH8_444   0x00200000 // Sunshine extension
 #define SCM_AV1_HIGH10_444  0x00400000 // Sunshine extension
+#define SCM_H263            0x10000000 // moonlight-N3DS extension
 
 // SCM masks to identify various codec capabilities
 #define SCM_MASK_H264   (SCM_H264 | SCM_H264_HIGH8_444)
diff --git a/src/RtspConnection.c b/src/RtspConnection.c
index 52ce2b1..4593763 100644
--- a/src/RtspConnection.c
+++ b/src/RtspConnection.c
@@ -1061,7 +1061,13 @@ int performRtspHandshake(PSERVER_INFORMATION serverInfo) {
             goto Exit;
         }
 
-        if ((StreamConfig.supportedVideoFormats & VIDEO_FORMAT_MASK_AV1) && strstr(response.payload, "AV1/90000")) {
+        if ((StreamConfig.supportedVideoFormats & VIDEO_FORMAT_MASK_H263) &&
+                (serverInfo->serverCodecModeSupport & SCM_H263) &&
+                strstr(response.payload, "H263-1998/90000")) {
+            // moonlight-N3DS extension: the host offers H.263+ and we asked for it
+            NegotiatedVideoFormat = VIDEO_FORMAT_H263;
+        }
+        else if ((StreamConfig.supportedVideoFormats & VIDEO_FORMAT_MASK_AV1) && strstr(response.payload, "AV1/90000")) {
             if ((serverInfo->serverCodecModeSupport & SCM_AV1_HIGH10_444) && (StreamConfig.supportedVideoFormats & VIDEO_FORMAT_AV1_HIGH10_444)) {
                 NegotiatedVideoFormat = VIDEO_FORMAT_AV1_HIGH10_444;
             }
