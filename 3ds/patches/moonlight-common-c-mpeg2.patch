             NegotiatedVideoFormat = VIDEO_FORMAT_H263;
         }
+        else if ((StreamConfig.supportedVideoFormats & VIDEO_FORMAT_MASK_MPEG2) &&
+                (serverInfo->serverCodecModeSupport & SCM_MPEG2) &&
