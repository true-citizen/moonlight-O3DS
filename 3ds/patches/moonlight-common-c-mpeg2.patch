                 NegotiatedVideoFormat = VIDEO_FORMAT_AV1_HIGH10_444;
@@ -1115,6 +1121,13 @@ int performRtspHandshake(PSERVER_INFORMATION serverInfo) {
             }
         }
 
+        // moonlight-N3DS: say why a requested alternative codec was or wasn't used
+        Limelog("Video format: asked 0x%x, host flags 0x%x, H263 rtpmap %s, MPEG2 rtpmap %s -> 0x%x\n",
+            StreamConfig.supportedVideoFormats, serverInfo->serverCodecModeSupport,
+            strstr(response.payload, "H263-1998/90000") ? "yes" : "no",
+            strstr(response.payload, "MPV/90000") ? "yes" : "no",
+            NegotiatedVideoFormat);
+
         // Look for the SDP attribute that indicates we're dealing with a server that supports RFI
         ReferenceFrameInvalidationSupported = strstr(response.payload, "x-nv-video[0].refPicInvalidation") != NULL;
         if (!ReferenceFrameInvalidationSupported) {
diff --git a/src/SdpGenerator.c b/src/SdpGenerator.c
